{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decision",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "created",
    "updated",
    "status",
    "history",
    "provenance",
    "demo",
    "publish",
    "decision",
    "rationale",
    "source_ids",
    "alternatives",
    "decision_maker",
    "revisit_conditions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+-[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "const": "decision"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "discovered",
        "evidence-collected",
        "investigating",
        "promising",
        "needs-validation",
        "paused",
        "rejected",
        "archived",
        "completed"
      ]
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "date",
          "status",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "enum": [
              "discovered",
              "evidence-collected",
              "investigating",
              "promising",
              "needs-validation",
              "paused",
              "rejected",
              "archived",
              "completed"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "agent",
        "session"
      ],
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "demo": {
      "type": "boolean"
    },
    "publish": {
      "type": "boolean"
    },
    "decision": {
      "type": [
        "string",
        "null"
      ]
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_maker": {
      "type": [
        "string",
        "null"
      ]
    },
    "revisit_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
