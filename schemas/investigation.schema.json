{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "investigation",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "created",
    "updated",
    "status",
    "history",
    "provenance",
    "demo",
    "publish",
    "objective",
    "summary",
    "related_problem_ids",
    "questions",
    "findings",
    "source_ids",
    "contradictory_findings",
    "unresolved_questions",
    "conclusions",
    "next_steps"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+-[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "const": "investigation"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "discovered",
        "evidence-collected",
        "investigating",
        "promising",
        "needs-validation",
        "paused",
        "rejected",
        "archived",
        "completed"
      ]
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "date",
          "status",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "enum": [
              "discovered",
              "evidence-collected",
              "investigating",
              "promising",
              "needs-validation",
              "paused",
              "rejected",
              "archived",
              "completed"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "agent",
        "session"
      ],
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "demo": {
      "type": "boolean"
    },
    "publish": {
      "type": "boolean"
    },
    "objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "related_problem_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "classification",
          "source_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "observed",
              "reported",
              "estimate",
              "interpretation",
              "hypothesis",
              "speculation",
              "unknown"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradictory_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "classification",
          "source_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "observed",
              "reported",
              "estimate",
              "interpretation",
              "hypothesis",
              "speculation",
              "unknown"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conclusions": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
