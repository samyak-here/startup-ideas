{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "problem",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "created",
    "updated",
    "status",
    "history",
    "provenance",
    "demo",
    "publish",
    "description",
    "customer_segment",
    "industries",
    "geography",
    "context",
    "evidence",
    "alternatives",
    "contradictory_evidence",
    "uncertainty",
    "related_problem_ids",
    "related_opportunity_ids",
    "open_questions",
    "next_actions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+-[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "const": "problem"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "discovered",
        "evidence-collected",
        "investigating",
        "promising",
        "needs-validation",
        "paused",
        "rejected",
        "archived",
        "completed"
      ]
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "date",
          "status",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "enum": [
              "discovered",
              "evidence-collected",
              "investigating",
              "promising",
              "needs-validation",
              "paused",
              "rejected",
              "archived",
              "completed"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "agent",
        "session"
      ],
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "demo": {
      "type": "boolean"
    },
    "publish": {
      "type": "boolean"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "customer_segment": {
      "type": [
        "string",
        "null"
      ]
    },
    "industries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "geography": {
      "type": [
        "string",
        "null"
      ]
    },
    "context": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "classification",
          "source_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "observed",
              "reported",
              "estimate",
              "interpretation",
              "hypothesis",
              "speculation",
              "unknown"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradictory_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "classification",
          "source_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "observed",
              "reported",
              "estimate",
              "interpretation",
              "hypothesis",
              "speculation",
              "unknown"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "uncertainty": {
      "type": [
        "string",
        "null"
      ]
    },
    "related_problem_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_opportunity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
